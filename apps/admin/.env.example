# apps/admin/.env.local (git-ignored). Locally: pnpm --filter admin env:local writes the Supabase values.

# Supabase project the admin site talks to (anon key only: the admin site never holds a service-role key).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "production" hides the STAGING tag in the header. Anything else (or unset) shows it.
# admin.caltracker.app is built with "staging" until go-live, while it points at the staging database.
NEXT_PUBLIC_APP_ENV=development

# PostHog timeline on the client page (server only). Without them the timeline shows database events only.
# Production: POSTHOG_PROJECT_ID is a plain Worker var (wrangler.jsonc), POSTHOG_PERSONAL_KEY a Worker secret.
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_KEY=
