{
  "expo": {
    "name": "CalTracker",
    "slug": "caltracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "caltracker",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "app.caltracker.client",
      "supportsTablet": true
    },
    "android": {
      "package": "app.caltracker.client",
      "adaptiveIcon": {
        "backgroundColor": "#C8F169",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "./plugins/without-push-entitlement.js",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "CalTracker uses your photos so you can send them to your coach, share them in your community and log your meals.",
          "cameraPermission": "CalTracker uses your camera so you can photograph your meals for your coach.",
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "CalTracker uses your photos so you can send them to your coach.",
          "savePhotosPermission": "Save your sticker cards to Photos.",
          "isAccessMediaLocationEnabled": false,
          "granularPermissions": []
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./node_modules/@expo-google-fonts/bricolage-grotesque/500Medium/BricolageGrotesque_500Medium.ttf",
            "./node_modules/@expo-google-fonts/bricolage-grotesque/700Bold/BricolageGrotesque_700Bold.ttf",
            "./node_modules/@expo-google-fonts/bricolage-grotesque/800ExtraBold/BricolageGrotesque_800ExtraBold.ttf",
            "./node_modules/@expo-google-fonts/caveat/700Bold/Caveat_700Bold.ttf"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ]
    ]
  }
}
