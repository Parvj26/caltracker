# Copy this file to .env.local and fill in real values.
# Never commit secrets: .env.local is git-ignored. Document every variable here.

# --- send-invite Edge Function (supabase/functions/.env locally; secrets in production) ---
# Public base URL used in invite links: <PUBLIC_SITE_URL>/invite/<token>
PUBLIC_SITE_URL=http://localhost:3000
# Production: Resend API key. Leave empty locally to send through the Supabase mail catcher.
RESEND_API_KEY=
# From address for invite emails (must be a verified Resend sender in production).
INVITE_FROM_EMAIL=CalTracker <invites@caltracker.app>
# Local mail catcher (Mailpit). Edge Functions run in Docker, so use host.docker.internal.
SMTP_HOST=host.docker.internal
SMTP_PORT=54325

# --- delete-account Edge Function (supabase/functions/.env locally; `supabase secrets set` in staging/production) ---
# Also uses RESEND_API_KEY and INVITE_FROM_EMAIL above for the "your client deleted their account" email to the coach.
# Optional: ask PostHog to forget the deleted person. A personal API key with person write access (a server secret,
# not the public project key) and the numeric project id. Leave empty to skip (the function logs that it skipped).
POSTHOG_PERSONAL_API_KEY=
POSTHOG_PROJECT_ID=
POSTHOG_API_HOST=https://us.posthog.com

# --- award-workout Edge Function (supabase/functions/.env locally; `supabase secrets set` in staging/production) ---
# Shared secret the pg_cron catch-up job sends (x-award-secret). It must equal the Vault secret
# 'award_workout_secret'. Locally supabase/seed.sql creates that one as local-award-workout-secret.
AWARD_WORKOUT_SECRET=local-award-workout-secret

# --- send-push Edge Function (supabase/functions/.env locally; `supabase secrets set` in staging/production) ---
# Shared secret the pg_cron push jobs send (x-push-secret). It must equal the Vault secret 'send_push_secret'.
# Locally supabase/seed.sql creates that one as local-send-push-secret.
SEND_PUSH_SECRET=local-send-push-secret
# Apple Push key (APNs, token auth). Leave all empty locally: 'send' then answers 503 and nothing is sent.
# APNS_KEY_P8 is the whole .p8 file content (-----BEGIN PRIVATE KEY----- ...). Never commit it or paste it in chat.
APNS_KEY_P8=
APNS_KEY_ID=
APNS_TEAM_ID=88L5M6CC34
APNS_TOPIC=app.caltracker.client
# sandbox for a locally built Debug app; production for TestFlight and App Store builds.
APNS_ENV=sandbox

# --- scripts/provision-coach.ts (operator only; also needs PUBLIC_SITE_URL above) ---
# Supabase API URL and service role key. Locally: `supabase status -o env`. Never commit the key.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# --- apps/web (coach dashboard) ---
# Written to apps/web/.env.local by `pnpm --filter web env:local` (reads `supabase status -o env`).
# Supabase API URL (local: http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase anon key (public by design; protected by RLS). Local: ANON_KEY from `supabase status -o env`.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# App store links shown on the public invite page /invite/<token>. Leave unset to show "Coming soon".
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=
# PostHog usage analytics (public write-only project key). Leave empty to turn analytics off (local, tests, CI).
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Coach website session recordings: off unless exactly `on`. Keep it off (local, tests, CI, staging, production) until
# the PO approves; even when on, the PostHog flag coach-session-replay still decides who is recorded.
NEXT_PUBLIC_SESSION_REPLAY=off
# The build's version, put in Help & feedback emails (the deploy workflow will set the short commit SHA). Unset: "dev".
NEXT_PUBLIC_RELEASE=

# --- apps/mobile (Expo client app) ---
# Written to apps/mobile/.env.local by `pnpm --filter mobile env:local [lan-ip]`.
# Simulator: http://127.0.0.1:54321. Real phone (Expo Go): http://<your-mac-lan-ip>:54321.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Supabase anon key (public by design; protected by RLS).
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# PostHog usage analytics (public write-only project key). Leave empty to turn analytics off.
EXPO_PUBLIC_POSTHOG_KEY=
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Tests (optional; only for a stack on non-default ports, e.g. the self-hosted CI runner's 545xx) ---
# Port the Playwright e2e run serves the web app on (default 3000).
E2E_WEB_PORT=
# Mailpit HTTP URL the e2e and integration tests read invite emails from (default http://127.0.0.1:54324).
MAILPIT_URL=
# Auth container scripts/tune-local-auth.sh targets is supabase_auth_<project id>; default: project_id in config.toml.
SUPABASE_PROJECT_ID=

# --- Staging deploy (GitHub Actions repository secrets, never in files; see docs/runbooks/staging.md) ---
# CLOUDFLARE_API_TOKEN, CLOUDFLARE_ACCOUNT_ID, RESEND_API_KEY, SUPABASE_ACCESS_TOKEN,
# STAGING_SUPABASE_PROJECT_REF, STAGING_SUPABASE_URL, STAGING_SUPABASE_ANON_KEY, STAGING_SUPABASE_DB_PASSWORD,
# STAGING_SUPABASE_SERVICE_ROLE_KEY, STAGING_SMOKE_COACH_EMAIL, STAGING_SMOKE_COACH_PASSWORD, STAGING_POSTHOG_KEY
