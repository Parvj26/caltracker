{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enabledPlugins": {
    "skill-creator@anthropic-plugin-directory": true,
    "frontend-design@anthropic-plugin-directory": true,
    "superpowers@anthropic-plugin-directory": true
  },
  "permissions": {
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git merge-base *)",
      "Bash(git rev-parse *)",
      "Bash(git ls-files *)",
      "Bash(gh pr view *)",
      "Bash(gh pr list *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr checks *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(pnpm check)",
      "Bash(pnpm test)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm --filter web test)",
      "Bash(pnpm --filter web typecheck)",
      "Bash(pnpm --filter web lint)",
      "Bash(pnpm --filter mobile test)",
      "Bash(pnpm --filter mobile typecheck)",
      "Bash(pnpm --filter mobile lint)",
      "Bash(pnpm --filter @caltracker/shared test)",
      "Bash(pnpm --filter @caltracker/shared typecheck)",
      "Bash(pnpm --filter @caltracker/shared lint)",
      "Bash(bash scripts/check-migrations.sh)"
    ],
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push origin main *)",
      "Bash(git push origin HEAD:main *)",
      "Bash(git diff *--output*)",
      "Bash(git log *--output*)",
      "Bash(git show *--output*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/eslint-fix.sh",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
